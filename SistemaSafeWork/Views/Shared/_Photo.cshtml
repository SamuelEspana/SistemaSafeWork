<section class="photo-section"><h2>Fotografía</h2><p class="muted">Carga un archivo JPG o PNG de hasta 5 MB. La fotografía es opcional.</p><div class="photo-controls"><img id="photo-preview" class="photo-preview" alt="Fotografía seleccionada" src="@(ViewBag.PhotoName!=null?Url.Action("Ver","Fotos",new{tipo=ViewBag.PhotoType,id=ViewBag.PhotoId}):Url.Content("~/Content/Images/placeholder.svg"))" />
<div><label for="foto">Cargar fotografía</label><input type="file" id="foto" name="foto" accept="image/jpeg,image/png" />
@if(ViewBag.Camera==true){<div class="camera-actions"><button type="button" class="btn" id="camera-start">Activar cámara</button><button type="button" class="btn" id="camera-capture" hidden>Tomar fotografía</button><button type="button" class="btn" id="camera-stop" hidden>Cerrar cámara</button></div><input type="hidden" name="captura" id="captura" /><video id="camera-video" autoplay muted playsinline hidden></video>}
<p id="photo-message" class="muted" role="status" aria-live="polite"></p></div></div></section>
