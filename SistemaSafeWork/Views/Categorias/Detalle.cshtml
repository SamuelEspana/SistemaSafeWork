@model SistemaSafeWork.Models.Categoria_Personal
@using SistemaSafeWork.Models
@using System.Linq
@{ViewBag.Title="Detalle de categoría";var items=((System.Collections.Generic.List<Aditamento>)ViewBag.Aditamentos).Where(a=>Model.AditamentoIds.Contains(a.Id));}
<div class="page-heading"><div><span class="eyebrow">CATEGORÍAS DE PERSONAL</span><h1>@Model.Nombre</h1><p>@Model.Descripcion</p></div><a class="btn" href="@Url.Action("Index")">Volver al listado</a></div>
<div class="panel"><h2>Aditamentos obligatorios</h2><p class="muted">El personal de esta categoría debe portar todos los aditamentos de este listado.</p><div class="table-scroll"><table><thead><tr><th>Código</th><th>Aditamento</th><th>Descripción</th></tr></thead><tbody>@foreach(var item in items){<tr><td>@item.Codigo</td><td>@item.Nombre</td><td>@item.Descripcion</td></tr>}</tbody></table></div></div>
