@model SistemaSafeWork.Models.Usuario
@{ViewBag.Title=Model.Id==0?"Crear usuario":"Editar usuario";}
<div class="page-heading"><div><span class="eyebrow">SEGURIDAD Y ACCESOS</span><h1>@ViewBag.Title</h1><p>Asigna un rol y controla el acceso al sistema.</p></div></div>
@using(Html.BeginForm()){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="errors",role="alert"})<div class="panel form-panel"><div class="form-grid"><div><label for="Nombre">Nombre</label>@Html.TextBoxFor(m=>m.Nombre,new{required="required",maxlength="120"})</div><div><label for="NombreUsuario">Usuario</label>@Html.TextBoxFor(m=>m.NombreUsuario,new{required="required",maxlength="60",autocomplete="off"})</div><div><label for="Contrasena">Contraseña</label>@Html.PasswordFor(m=>m.Contrasena,new{autocomplete="new-password",minlength="10",maxlength="128"})<small>@(Model.Id==0?"Obligatoria, mínimo 10 caracteres.":"Deja vacío para conservar la contraseña actual.")</small></div><div><label for="RolId">Rol</label>@Html.DropDownListFor(m=>m.RolId,(SelectList)ViewBag.Roles,"Seleccionar rol",new{required="required"})</div></div><label class="check-label">@Html.CheckBoxFor(m=>m.Activo) Cuenta activa</label><div class="form-actions"><button class="btn primary">Guardar usuario</button><a class="btn" href="@Url.Action("Index")">Cancelar</a></div></div>}
