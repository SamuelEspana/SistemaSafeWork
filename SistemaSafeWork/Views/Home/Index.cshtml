@using SistemaSafeWork.Models
@{ViewBag.Title="Dashboard";}
<div class="page-heading"><div><span class="eyebrow">VISTA GENERAL</span><h1>Dashboard</h1><p>Tu equipo, sus categorías y su protección en un solo lugar.</p></div><span class="pill">Gestión de personal</span></div>
<section class="dashboard-banner"><div><span class="eyebrow">SAFEWORK SOLUTIONS</span><h2>La seguridad empieza<br />antes de entrar.</h2><p>Prepara las categorías y el equipo requerido para cada persona.</p>@if(Access.Has(Context,"personas.crear")){<a class="btn primary" href="@Url.Action("Crear","Personas")">+ Registrar persona</a>}</div><div class="shield-art" aria-hidden="true">✓</div></section>
<div class="stats-grid">@if(ViewBag.Personas!=null){<a class="stat panel" href="@Url.Action("Index","Personas")"><span class="stat-icon">◉</span><strong>@ViewBag.Personas</strong><h3>Personas registradas</h3><p>Consulta y administra tu personal →</p></a>}@if(ViewBag.Categorias!=null){<a class="stat panel" href="@Url.Action("Index","Categorias")"><span class="stat-icon">▦</span><strong>@ViewBag.Categorias</strong><h3>Categorías de personal</h3><p>Define el equipo por actividad →</p></a>}@if(ViewBag.Aditamentos!=null){<a class="stat panel" href="@Url.Action("Index","Aditamentos")"><span class="stat-icon">◇</span><strong>@ViewBag.Aditamentos</strong><h3>Aditamentos</h3><p>Organiza el catálogo de protección →</p></a>}</div>
<div class="panel workflow"><span class="eyebrow">CONFIGURACIÓN INICIAL</span><h2>Prepara tu entorno de trabajo</h2><div class="workflow-grid"><div><span class="step">01</span><h3>Registra aditamentos</h3><p>Casco, chaleco y el equipo que necesites.</p></div><div><span class="step">02</span><h3>Define las categorías</h3><p>Asigna los aditamentos obligatorios por categoría.</p></div><div><span class="step">03</span><h3>Agrega al personal</h3><p>Asigna una categoría y registra su fotografía.</p></div></div></div>
