@model System.Data.DataTable
@using System.Data
@using SistemaSafeWork.Models
@{ViewBag.Title="Roles y permisos";}
<div class="page-heading"><div><span class="eyebrow">SAFEWORK · ADMINISTRACIÓN</span><h1>Roles y permisos</h1><p>Configura los permisos de cada rol de trabajo.</p></div>@if(Access.Has(Context,"roles.crear")){<a class="btn primary" href="@Url.Action("Crear")">+ Agregar registro</a>}</div>
<div class="panel">
@if(Model.Rows.Count==0){<div class="empty"><h2>No hay registros para mostrar</h2><p>Agrega un registro o cambia tu búsqueda para comenzar.</p></div>}else{<div class="table-scroll"><table><thead><tr><th>Nombre</th><th>Permisos</th><th>Acciones</th></tr></thead><tbody>@foreach(DataRow row in Model.Rows){<tr><td>@row["Nombre"]</td><td>@(row["Nombre"].ToString()=="Administrador"?"Acceso total":row["Permisos"].ToString()+" permisos")</td><td class="actions">@if(Access.Has(Context,"roles.editar")){<a href="@Url.Action("Editar",new{id=row["Id"]})">Editar</a>}@if(Access.Has(Context,"roles.eliminar")){<a class="delete" href="@Url.Action("Eliminar",new{id=row["Id"]})">Eliminar</a>}</td></tr>}</tbody></table></div>}</div>
