@{ViewBag.Title="Eliminar registro";}
<div class="page-heading"><div><span class="eyebrow">CONFIRMACIÓN</span><h1>Eliminar registro</h1></div></div><div class="panel form-panel"><h2>@ViewBag.Nombre</h2><p>Se eliminará este registro de forma permanente. Los registros que estén en uso deben desvincularse primero.</p>
@using(Html.BeginForm()){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="errors",role="alert"})<div class="form-actions"><button class="btn danger" type="submit">Confirmar eliminación</button><a class="btn" href="@Url.Action("Index")">Cancelar</a></div>}</div>
