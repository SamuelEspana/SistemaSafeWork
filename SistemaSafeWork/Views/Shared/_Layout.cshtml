@using SistemaSafeWork.Models
@{ var current=Access.Current(Context); var active=ViewContext.RouteData.Values["controller"].ToString(); }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@ViewBag.Title · SafeWork</title><link rel="stylesheet" href="@Url.Content("~/Content/SafeWork.css")" /></head><body>
<header class="topbar"><a class="logo" href="@Url.Action("Index","Home")"><img src="@Url.Content("~/Content/Images/safework.png")" alt="SafeWork Solutions" /></a><button class="btn menu-toggle" type="button" id="menu-toggle" aria-controls="main-menu" aria-expanded="false">Menú</button><div class="user-info"><span>@(current?.Nombre)<small>@(current?.Rol)</small></span>@using(Html.BeginForm("Salir","Cuenta",FormMethod.Post)){@Html.AntiForgeryToken()<button class="btn" type="submit">Salir</button>}</div></header>
<div class="app-shell"><aside class="sidebar" id="main-menu"><span class="nav-caption">PRINCIPAL</span><nav aria-label="Navegación principal"><a href="@Url.Action("Index","Home")" class="@(active=="Home"?"active":"")"><span>◈</span> Inicio</a>
@foreach(var item in new[]{new[]{"Personas","Personal","personas.ver","◉"},new[]{"Categorias","Categorías de personal","categorias.ver","▦"},new[]{"Aditamentos","Aditamentos","aditamentos.ver","◇"},new[]{"Usuarios","Usuarios","usuarios.ver","◎"},new[]{"Roles","Roles y permisos","roles.ver","⚙"}}){if(Access.Has(Context,item[2])){<a href="@Url.Action("Index",item[0])" class="@(active==item[0]?"active":"")"><span>@item[3]</span> @item[1]</a>}}
@if(Access.Has(Context,"cuenta.contrasena")){<a href="@Url.Action("CambiarContrasena","Cuenta")"><span>↗</span> Cambiar contraseña</a>}</nav>@if(Access.Has(Context,"seguridad.validacion.ver")||Access.Has(Context,"seguridad.monitoreo.ver")||Access.Has(Context,"seguridad.monitoreo.capturas.ver")){<span class="nav-caption security-caption">SEGURIDAD</span><nav aria-label="Seguridad">@if(Access.Has(Context,"seguridad.validacion.ver")){<a href="@Url.Action("Index","ValidacionAditamentos")" class="@(active=="ValidacionAditamentos"?"active":"")"><span>✓</span> Validación Aditamentos</a>}@if(Access.Has(Context,"seguridad.monitoreo.ver")){<a href="@Url.Action("Index","Monitoreo")" class="@(active=="Monitoreo"?"active":"")"><span>◎</span> Monitoreo</a>}@if(Access.Has(Context,"seguridad.monitoreo.capturas.ver")){<a href="@Url.Action("Index","CapturasMonitoreo")" class="@(active=="CapturasMonitoreo"?"active":"")"><span>▧</span> Capturas de monitoreo</a>}</nav>}<div class="sidebar-foot"><span class="status-dot"></span> SafeWork Solutions<small>Gestión de seguridad laboral</small></div></aside><main class="main-content">@if(TempData["Success"]!=null){<div class="success" role="status">@TempData["Success"]</div>}@RenderBody()<footer>SafeWork Solutions · Seguridad en cada ingreso</footer></main></div><script src="@Url.Content("~/Scripts/safework.js")"></script>@RenderSection("scripts",required:false)</body></html>

